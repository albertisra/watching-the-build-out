# Credentials template. Copy of the variable names used by the code.
# Fill in the real values in `.env` only (never in this file, never in chat).
# Code reads these at runtime via os.environ / python-dotenv. Nothing prints them.

# Copernicus Data Space Ecosystem (CDSE): OAuth client for Sentinel Hub and openEO.
# Create under CDSE Dashboard -> User settings -> OAuth clients.
CDSE_CLIENT_ID=
# Secret belonging to the OAuth client above.
CDSE_CLIENT_SECRET=

# CDSE account login (e-mail), used only for OData/token-based downloads.
CDSE_USERNAME=
# CDSE account password, used only for OData/token-based downloads.
CDSE_PASSWORD=

# CDSE S3 access key for the eodata bucket (optional; generate in the CDSE S3 key manager).
CDSE_S3_ACCESS_KEY=
# CDSE S3 secret key belonging to the access key above (optional).
CDSE_S3_SECRET_KEY=

# Optional: Microsoft Planetary Computer subscription key. Not required; anonymous access works with lower rate limits.
PC_SDK_SUBSCRIPTION_KEY=

# Optional: Google Earth Engine cloud project ID (non-commercial research use only; read the terms first).
EE_PROJECT=

# Optional, not used unless the author asks: ENTSO-E Transparency Platform API token.
ENTSOE_API_TOKEN=
